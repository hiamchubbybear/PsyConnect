# 32 characters minimum recommended

# ========================================
# 📨 Kafka Configuration
# ========================================
NOTIFICATION_CREATE_TOPIC=notification_create_topic

# ========================================
# 🔗 External Services
# ========================================
baseUriProfileService=http://localhost:8081
app.oauth2.redirect-base=http://localhost:3000
