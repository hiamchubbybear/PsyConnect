# ========================================
# 🌐 Service Configuration
# ========================================
SERVER_PORT=8080

# ========================================
# 🗄️ Database Configuration
# ========================================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/identityservice
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=12345678

# ========================================
# 🔐 Security & Keys
