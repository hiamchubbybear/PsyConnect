# ========================================
# 🌐 Service Configuration
# ========================================
SERVICE_ENV=consultationservice
SERVICE_PORT=8084
SERVICE_HOST=localhost

# ========================================
# 🗄️ MongoDB Configuration
# ========================================
DB_HOST=localhost
DB_PORT=27017
DB_USER=consultationservice
DB_PASS=your-password
DB_NAME=consultationservice

# ========================================
# 📨 Kafka Configuration
# ========================================
KAFKA_ADDRESS=localhost:9092
KAFKA_TOPIC=consultation.test
KAFKA_PARTITION=0
CONSUMER_GROUP=consultation

# ========================================
# 🔗 gRPC Configuration
# ========================================
GRPC_ADDRESS=127.0.0.1:9091

# ========================================
# 🔴 Redis Configuration
# ========================================
CONSULTATION_REDIS_ADDRESS=localhost:6379
CONSULTATION_PROTOCOL=2
CONSULTATION_REDIS_PASSWORD=your-redis-password
CONSULTATION_DB=0

# ========================================
# 🔗 Service URLs
# ========================================
BASE_URI_NOTIFICATION_SERVICE=http://localhost:8082
BASE_URI_PROFILE_SERVICE=http://localhost:8081

# ========================================
# 🔐 External Service Credentials
# ========================================
# Mail sender
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# OAuth2 Facebook
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT
JWT_SIGNER_KEY=your-jwt-signer-key

# MySQL
MYSQL_PASSWORD=your-mysql-password
MYSQL_USERNAME=root

# Neo4j
NEO4J_PASSWORD_PROFILE_SERVICE=your-neo4j-password

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
