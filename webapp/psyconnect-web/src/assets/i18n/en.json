    "frequently_asked": "Frequently Asked Questions",
    "faq_items": [
        {
            "question": "How do I know which expert is right for me?",
            "answer": "You can view detailed profiles, specializations, experience, and reviews of each expert. We also have a recommendation system based on your needs."
        },
        {
            "question": "How much does counseling cost?",
            "answer": "Costs range from 300,000 - 1,200,000 VND per session depending on the service type and expert experience. You can see specific prices on each expert's profile."
        },
        {
            "question": "Is my information kept confidential?",
            "answer": "Absolutely. We apply end-to-end encryption and strictly comply with personal information security regulations."
        },
        {
            "question": "Can I cancel appointments?",
            "answer": "Yes, you can cancel appointments 24 hours in advance without charge. Cancellations within 24 hours may incur fees according to each expert's policy."
        },
        {
            "question": "What if I need emergency support?",
            "answer": "For emergency cases, please call the hotline 113 or contact the nearest medical facility. PsyConnect does not provide emergency psychological services."
        }
    ],
